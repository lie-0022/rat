  m_Script: {fileID: 11500000, guid: ff81fafafd5fc4675921b81b82a3d61f, type: 3}
  m_Name: LocalizationTable
  m_EditorClassIdentifier: RatGame.Runtime::RatGame.Data.LocalizationTableSO
  _entries:
  - Ko: "\uC950\uB3C4 \uC0C8\uB3C4 \uBAA8\uB974\uAC8C"
    En: Not Even a Mouse
  - Ko: "1~4\uC778 \uD611\uB3D9 \uC740\uC2E0 \uC57D\uD0C8"
    En: 1-4 player co-op stealth heist
  - Ko: "\uD638\uC2A4\uD2B8 \uC2DC\uC791"
    En: Host Game
  - Ko: "\uCE5C\uAD6C \uBC29 \uCC38\uAC00"
    En: Join Friend
  - Ko: "\uC124\uC815"
    En: Settings
  - Ko: "\uC885\uB8CC"
    En: Quit
  - Ko: "\uB85C\uCEEC \uBAA8\uB4DC"
    En: Local mode
  - Ko: "\uB85C\uCEEC \uBAA8\uB4DC (\uAC19\uC740 PC\uC5D0\uC11C\uB9CC \uCC38\uAC00)"
    En: Local mode (same PC only)
  - Ko: " \xB7 \uAC1C\uBC1C \uBE4C\uB4DC"
    En: " \xB7 dev build"
  - Ko: "\uAE30\uC9C0\uB97C \uC5EC\uB294 \uC911\u2026"
    En: "Opening the base\u2026"
  - Ko: "\uD638\uC2A4\uD2B8\uB97C \uC2DC\uC791\uD558\uC9C0 \uBABB\uD588\uC5B4\uC694.
      \uC774\uBBF8 \uCF1C\uC9C4 \uAC8C\uC784\uC774 \uC788\uB294\uC9C0 \uD655\uC778\uD558\uC138\uC694."
    En: Couldn't start hosting. Is another game already running?
  - Ko: "\uCE5C\uAD6C\uAC00 \uBCF4\uB0B8 \uCD08\uB300\uB97C \uC218\uB77D\uD558\uBA74
      \uBC14\uB85C \uB4E4\uC5B4\uAC00\uC694.\n(Steam \uCE5C\uAD6C \uBAA9\uB85D\uC5D0\uC11C
      \"\uAC8C\uC784 \uCC38\uAC00\"\uB3C4 \uB3FC\uC694)"
    En: 'Accept a friend''s invite to join.

      ("Join Game" in the Steam friends
      list works too)'
  - Ko: "\uAE30\uC9C0\uC5D0 \uC811\uC18D\uD558\uB294 \uC911\u2026"
    En: "Connecting to the base\u2026"
  - Ko: "\uC811\uC18D\uC744 \uC2DC\uC791\uD558\uC9C0 \uBABB\uD588\uC5B4\uC694."
    En: Couldn't start connecting.
  - Ko: "\uD638\uC2A4\uD2B8\uB97C \uCC3E\uC9C0 \uBABB\uD588\uC5B4\uC694. \uCE5C\uAD6C\uAC00
      \uBC29\uC744 \uC5F4\uC5C8\uB294\uC9C0 \uD655\uC778\uD558\uC138\uC694."
    En: Host not found. Did your friend open a room?
  - Ko: "\uC77C\uC2DC\uC815\uC9C0"
    En: Paused
  - Ko: "\uACC4\uC18D\uD558\uAE30"
    En: Resume
  - Ko: "\uC138\uC158 \uB098\uAC00\uAE30"
    En: Leave Session
  - Ko: "\uB098\uAC00\uAE30"
    En: Leave
  - Ko: "\uCDE8\uC18C"
    En: Cancel
  - Ko: "\uD638\uC2A4\uD2B8\uAC00 \uB098\uAC00\uBA74 \uCE5C\uAD6C\uB4E4\uC758 \uC138\uC158\uB3C4
      \uB05D\uB098\uC694.\n\uBA54\uC778 \uBA54\uB274\uB85C \uB098\uAC08\uAE4C\uC694?"
    En: 'If the host leaves, everyone''s session ends.

      Return to main menu?'
  - Ko: "\uBA54\uC778 \uBA54\uB274\uB85C \uB098\uAC08\uAE4C\uC694?\n\uCE5C\uAD6C\uB4E4\uC740
      \uACC4\uC18D \uD50C\uB808\uC774\uD574\uC694."
    En: 'Return to main menu?

      Your friends keep playing.'
  - Ko: "\uB0B4\uAC00 \uC5F0 \uBC29"
    En: My room
  - Ko: "\uCE5C\uAD6C \uBC29"
    En: Friend's room
  - Ko: "\uBA85"
    En: ' players'
  - Ko: "\uC870\uC791"
    En: Controls
  - Ko: "\uB9C8\uC6B0\uC2A4 \uAC10\uB3C4"
    En: Mouse sensitivity
  - Ko: "\uC6C5\uD06C\uB9AC\uAE30"
    En: Crouch
  - Ko: "\uD654\uBA74 \uD754\uB4E4\uB9BC"
    En: Camera shake
  - Ko: "\uD654\uBA74"
    En: Display
  - Ko: "\uD654\uBA74 \uBAA8\uB4DC"
    En: Screen mode
  - Ko: "\uD574\uC0C1\uB3C4"
    En: Resolution
  - Ko: "\uC5B8\uC5B4"
    En: Language
  - Ko: "\uC18C\uB9AC"
    En: Audio
  - Ko: "\uC804\uCCB4"
    En: Master
  - Ko: "\uD6A8\uACFC\uC74C"
    En: Effects
  - Ko: "\uC74C\uC545"
    En: Music
  - Ko: "\uBCF4\uC774\uC2A4"
    En: Voice
  - Ko: "\uAE30\uBCF8\uAC12"
    En: Defaults
  - Ko: "\uB2EB\uAE30"
    En: Close
  - Ko: "\uC801\uC6A9"
    En: Apply
  - Ko: "\uB204\uB974\uACE0 \uC788\uAE30"
    En: Hold
  - Ko: "\uB20C\uB7EC\uC11C \uC804\uD658"
    En: Toggle
  - Ko: "\uCF2C"
    En: On
  - Ko: "\uB054"
    En: Off
  - Ko: "\uC804\uCCB4 \uD654\uBA74"
    En: Fullscreen
  - Ko: "\uD14C\uB450\uB9AC \uC5C6\uB294 \uCC3D"
    En: Borderless
  - Ko: "\uCC3D \uBAA8\uB4DC"
    En: Windowed
  - Ko: "\uAE30\uBCF8\uAC12\uC73C\uB85C \uBC14\uAFE8\uC5B4\uC694. [\uC801\uC6A9]\uC744
      \uB20C\uB7EC\uC57C \uC800\uC7A5\uB3FC\uC694."
    En: Reset to defaults. Press [Apply] to save.
  - Ko: "\uC801\uC6A9\uD588\uC5B4\uC694."
    En: Applied.
  - Ko: "[\uC801\uC6A9]\uC744 \uB204\uB974\uBA74 \uC5B8\uC5B4\uAC00 \uBC14\uB00C\uC5B4\uC694."
    En: Press [Apply] to change the language.
  - Ko: "\uBC30\uACBD \uC7A5\uBA74 \uC790\uB9AC\n\uC950\uAD6C\uBA4D \uC55E\uC5D0\uC11C
      \uC950 4\uB9C8\uB9AC \uB300\uAE30 (\uC544\uD2B8 \uB2E8\uACC4)"
    En: 'Background scene placeholder

      4 mice waiting at the mousehole (art
      pass)'
  - Ko: "Esc \xB7 \uACC4\uC18D\uD558\uAE30   (\uAC8C\uC784\uC740 \uBA48\uCD94\uC9C0
      \uC54A\uC544\uC694)"
    En: "Esc \xB7 Resume   (the game keeps running)"
