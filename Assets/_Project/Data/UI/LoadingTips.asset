  m_Script: {fileID: 11500000, guid: 08d9d9054d37e41d7b541aee1476d78a, type: 3}
  m_Name: LoadingTips
  m_EditorClassIdentifier: RatGame.Runtime::RatGame.Data.LoadingTipsSO
  _tips:
  - "\uC6C5\uD06C\uB9AC\uBA74 \uBC1C\uC18C\uB9AC\uAC00 \uB098\uC9C0 \uC54A\uC544\uC694.
    \uACE0\uC591\uC774 \uADFC\uCC98\uC5D0\uC120 \uAE30\uC5B4\uAC00\uC138\uC694."
  - "\uACC4\uB780\uC740 \uB358\uC9C0\uBA74 \uAE68\uC838\uC694. \uAD74\uB824\uC11C
    \uC950\uAD6C\uBA4D\uC5D0 \uB123\uC73C\uC138\uC694."
  - "\uC950\uAD6C\uBA4D\uC5D0 \uB123\uC740 \uBB3C\uAC74\uC740 \uC548\uC804\uD574\uC694.
    \uC804\uBA78\uD558\uBA74 \uC774\uBC88 \uC801\uB9BD\uC740 \uC783\uC5B4\uC694."
  - "\uBB34\uAC70\uC6B4 \uAC74 \uC5EC\uB7FF\uC774 \uAC19\uC774 \uB4E4\uBA74 \uC6C0\uC9C1\uC5EC\uC694."
  - "\uC5B4\uB450\uC6B4 \uACF3\uC5D0\uC120 \uACE0\uC591\uC774 \uC2DC\uC57C\uAC00
    \uC808\uBC18\uC774 \uB3FC\uC694."
  - "\uC4F0\uB7EC\uC9C4 \uB3D9\uB8CC\uB97C \uC950\uAD6C\uBA4D\uAE4C\uC9C0 \uC62E\uAE30\uBA74
    \uB2E4\uC2DC \uC77C\uC5B4\uB098\uC694."
  - "\uB048\uB048\uC774\uC5D0 \uBD99\uC740 \uB3D9\uB8CC\uB294 [E]\uB97C \uAE38\uAC8C
    \uB20C\uB7EC \uAD6C\uCD9C\uD558\uC138\uC694."
  - "\uACE7\uAC8C \uB2EC\uB9AC\uBA74 \uACE0\uC591\uC774\uBCF4\uB2E4 \uBE68\uB77C\uC694.
    \uB9C9\uB2E4\uB978 \uAE38\uB9CC \uD53C\uD558\uC138\uC694."
